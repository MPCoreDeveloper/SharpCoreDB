<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Version>1.9.5</Version>
    <PackageId>SharpCoreDB.DebugBenchmark</PackageId>
    <Authors>MPCoreDeveloper</Authors>
    <Company>SharpCoreDB</Company>
    <Description>Debug benchmark harness for SharpCoreDB.</Description>
    <PackageReleaseNotes>v1.9.5: Fixes parameterized query binding (token-aware named-parameter replacement, resolving @t/@tid collisions), forwards request parameters through the server (gRPC, binary protocol, WebSocket), makes ULID encoding standards-compliant (Crockford Base32 per the ULID spec), removes the legacy UI (moved to SCDMS), documentation is now English-only, and NuGet dependencies updated.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCoreDB\SharpCoreDB.csproj" />
    <ProjectReference Include="..\..\tests\SharpCoreDB.Benchmarks\SharpCoreDB.Benchmarks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="LiteDB" />
    <PackageReference Include="Bogus" />
    <!-- Microsoft.Data.Sqlite + SQLitePCLRaw.bundle_e_sqlite3 managed centrally in Directory.Packages.props
         (explicit reference kept to force safe non-vulnerable SQLite stack) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    
  </ItemGroup>

</Project>

