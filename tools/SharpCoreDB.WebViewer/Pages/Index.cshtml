    </div>
</div>

<dialog id="scdb-create-db-dialog" class="scdb-snippet-dialog">
    <form method="post" asp-page-handler="CreateDatabase" id="form-create-db">
        @Html.AntiForgeryToken()
        <div class="scdb-snippet-dialog__header">
            <h3 class="scdb-no-margin">Create New Database</h3>
            <button type="button" class="scdb-snippet-dialog__close" data-action="close-create-db" aria-label="Close">✕</button>
        </div>
        <div class="scdb-snippet-dialog__body">
            <div class="scdb-form-group">
                <label class="scdb-label" for="create-db-name">Database name</label>
                <input type="text" class="scdb-input" id="create-db-name" name="NewDatabaseName" placeholder="My New Database" />
            </div>
            <div class="scdb-form-group">
                <label class="scdb-label" for="create-db-path">Database path <span class="scdb-required">*</span></label>
                <input type="text" class="scdb-input" id="create-db-path" name="NewDatabasePath" placeholder="C:\data\mynewdb" />
                <span class="scdb-validation-message" id="create-db-path-error"></span>
                <small class="scdb-text-muted scdb-text-12">The folder will be created if it does not exist.</small>
            </div>
            <div class="scdb-form-group">
                <label class="scdb-label" for="create-db-mode">Storage mode</label>
                <select class="scdb-select" id="create-db-mode" name="NewDatabaseStorageMode">
                    <option value="Directory">Directory</option>
                    <option value="SingleFile">Single File</option>
                </select>
            </div>
            <div class="scdb-form-group">
                <label class="scdb-label" for="create-db-password">Password <span class="scdb-required">*</span></label>
                <input type="password" class="scdb-input" id="create-db-password" name="NewDatabasePassword" placeholder="Choose a database password" />
                <span class="scdb-validation-message" id="create-db-password-error"></span>
                <small class="scdb-text-muted scdb-text-12">Required — used to encrypt and open the database.</small>
            </div>
        </div>
        <div class="scdb-snippet-dialog__footer">
            <button type="button" class="scdb-btn scdb-btn--secondary" data-action="close-create-db">Cancel</button>
            <button type="submit" class="scdb-btn scdb-btn--primary">Create & Connect</button>
        </div>
    </form>
</dialog>

<dialog id="scdb-create-table-dialog" class="scdb-snippet-dialog">
    <form method="post" asp-page-handler="CreateTable">
        @Html.AntiForgeryToken()
        <div class="scdb-snippet-dialog__header">
            <h3 class="scdb-no-margin">New Table (Table Designer)</h3>
            <button type="button" class="scdb-snippet-dialog__close" data-action="close-create-table" aria-label="Close">✕</button>
        </div>
        <div class="scdb-snippet-dialog__body">
            <div class="scdb-form-group">
                <label class="scdb-label" for="new-table-name">Table name <span class="scdb-required">*</span></label>
                <input type="text" class="scdb-input scdb-mono" id="new-table-name" name="NewTableName" placeholder="customers" />
            </div>
            <div class="scdb-form-group">
                <label class="scdb-label" for="new-table-columns">Column definitions</label>
                <textarea class="scdb-input scdb-mono" id="new-table-columns" name="NewTableColumnsDefinition" rows="6">Id INTEGER PRIMARY KEY AUTOINCREMENT, Name TEXT NULL</textarea>
                <small class="scdb-text-muted scdb-text-12">Comma-separated: <code>Name TYPE [NOT NULL] [PRIMARY KEY]</code></small>
            </div>
            <div class="scdb-alert scdb-alert--warn">
                <span>ℹ</span>
                <span>Each row becomes one line in the CREATE TABLE statement.</span>
            </div>
        </div>
        <div class="scdb-snippet-dialog__footer">
            <button type="button" class="scdb-btn scdb-btn--secondary" data-action="close-create-table">Cancel</button>
            <button type="submit" class="scdb-btn scdb-btn--primary">Create Table</button>
        </div>
    </form>
</dialog>

<dialog id="scdb-import-csv-dialog" class="scdb-snippet-dialog">
    <form method="post" asp-page-handler="ImportCsv">
        @Html.AntiForgeryToken()
        <div class="scdb-snippet-dialog__header">
            <h3 class="scdb-no-margin">Import CSV to New Table</h3>
            <button type="button" class="scdb-snippet-dialog__close" data-action="close-import-csv" aria-label="Close">✕</button>
        </div>
        <div class="scdb-snippet-dialog__body">
            <div class="scdb-form-group">
                <label class="scdb-label" for="import-csv-table-name">Target table name <span class="scdb-required">*</span></label>
                <input type="text" class="scdb-input scdb-mono" id="import-csv-table-name" name="ImportCsvTableName" placeholder="imported_data" />
            </div>
            <div class="scdb-form-group">
                <label class="scdb-label" for="import-csv-content">CSV content <span class="scdb-required">*</span></label>
                <textarea class="scdb-input scdb-mono" id="import-csv-content" name="ImportCsvContent" rows="8" placeholder="id,name,email&#10;1,Alice,alice@example.com&#10;2,Bob,bob@example.com"></textarea>
                <small class="scdb-text-muted scdb-text-12">First row is the header. Column types (INTEGER/REAL/TEXT) are inferred automatically.</small>
            </div>
        </div>
        <div class="scdb-snippet-dialog__footer">
            <button type="button" class="scdb-btn scdb-btn--secondary" data-action="close-import-csv">Cancel</button>
            <button type="submit" class="scdb-btn scdb-btn--primary">Import</button>
        </div>
    </form>
</dialog>

<dialog id="scdb-snippet-dialog" class="scdb-snippet-dialog">
    <div class="scdb-snippet-dialog__header">
        <h3 class="scdb-no-margin">Add SQL Snippet</h3>
        <button type="button" class="scdb-snippet-dialog__close" data-action="close-snippet-dialog" aria-label="Close">✕</button>
    </div>
    <div class="scdb-snippet-dialog__body">
        <div class="scdb-form-group">
            <label class="scdb-label" for="snippet-name">Snippet Name</label>
            <input type="text" class="scdb-input" id="snippet-name" placeholder="e.g., Select All Users" />
        </div>
        <div class="scdb-form-group">
            <label class="scdb-label" for="snippet-category">Category (optional)</label>
            <input type="text" class="scdb-input" id="snippet-category" placeholder="e.g., Common Queries" />
        </div>
        <div class="scdb-form-group">
            <label class="scdb-label" for="snippet-sql">SQL Template</label>
