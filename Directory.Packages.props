    <PackageVersion Include="SharpCoreDB.Extensions" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Functional" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Functional.Dapper" Version="$(SharpCoreDBVersion)" />
    <PackageVersion Include="SharpCoreDB.Functional.EntityFrameworkCore" Version="$(SharpCoreDBVersion)" />
