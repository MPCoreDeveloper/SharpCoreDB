    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Dotmim.Sync.Core" Version="1.3.0" />
    <PackageVersion Include="Dotmim.Sync.Sqlite" Version="1.3.0" />
