<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>

    <!-- Test Configuration -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    
    <!-- Test project, not a NuGet package -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing frameworks -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" >
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" >
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Assertions & Mocking -->
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />

    <!-- Sync Dependencies -->
    <PackageReference Include="Dotmim.Sync.Core" />
    <PackageReference Include="Dotmim.Sync.Sqlite" />
    <!-- NOTE: We deliberately do NOT reference System.Data.SQLite.Core (Legacy+CriticalBugs).
         Dotmim.Sync.Sqlite may still pull Stub.System.Data.SQLite internally.
         We force modern Microsoft.Data.Sqlite + safe SQLitePCLRaw below. -->

    <PackageReference Include="SharpCoreDB" Condition="'$(UseSharpCoreDBPackage)' == 'true'" />
    <PackageReference Include="SharpCoreDB.Data.Provider" Condition="'$(UseSharpCoreDBPackage)' == 'true'" />
  </ItemGroup>

  <!-- Reference local SharpCoreDB when not using NuGet packages -->
  <ItemGroup Condition="'$(UseSharpCoreDBPackage)' != 'true'">
    <ProjectReference Include="..\..\src\SharpCoreDB\SharpCoreDB.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreDB.Data.Provider\SharpCoreDB.Data.Provider.csproj" />
    <ProjectReference Include="..\..\src\SharpCoreDB.Provider.Sync\SharpCoreDB.Provider.Sync.csproj" />
  </ItemGroup>

  <!-- Reference provider project -->
  <ItemGroup Condition="'$(UseSharpCoreDBPackage)' == 'true'">
    <ProjectReference Include="..\..\src\SharpCoreDB.Provider.Sync\SharpCoreDB.Provider.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Data.Sqlite + SQLitePCLRaw.bundle_e_sqlite3 managed centrally in Directory.Packages.props
         (explicit reference kept to force safe non-vulnerable SQLite stack) -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    
  </ItemGroup>

</Project>

